{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "cloudformation:ValidateTemplate",
                "iam:GetRole",
                "iam:SimulatePrincipalPolicy",
                "s3:HeadBucket",
                "s3:ListBucket",
                "s3:GetBucketLocation",
                "s3:GetObject"
            ],
            "Resource": "*"
        }
    ]
}